# Local dev: leave as /api. Vite proxies it to the backend (see vite.config.ts).
# For a deployed SPA on another origin, use the full API URL, e.g. https://api.example.com/api
VITE_API_BASE_URL=/api
# Optional: Cloudflare Turnstile site key (also served from GET /api/public-config)
VITE_TURNSTILE_SITE_KEY=
