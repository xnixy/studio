# Optional. If unset, the app uses your Expo/Metro LAN IP + port 3001.
# Phone and PC must be on the same network (or use Tailscale / tunnel).
#
# Example (Ethernet IP from your PC):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.0.131:3001/api
#
# Staging:
# EXPO_PUBLIC_API_BASE_URL=https://api.example.com/api
