+// Studio patch: iPad sidebar mode.
+// UITabBarController exposes contentLayoutGuide for the unobscured content column, but RN
+// still sizes the tab screen to the full host width so content draws under the sidebar.
+// Force the screen view frame to the content guide and mirror that as safe-area insets.
+- (void)viewDidLayoutSubviews
+{
+  [super viewDidLayoutSubviews];
+#if !TARGET_OS_TV
+  if (@available(iOS 18.0, *)) {
+    UITabBarController *tbc = self.tabBarController;
+    if (tbc == nil) {
+      return;
+    }
+
+    UIEdgeInsets nextInsets = UIEdgeInsetsZero;
+    if (tbc.mode == UITabBarControllerModeTabSidebar) {
+      UILayoutGuide *guide = tbc.contentLayoutGuide;
+      if (guide != nil && guide.owningView != nil && self.view.superview != nil) {
+        CGRect contentInTab = [guide.owningView convertRect:guide.layoutFrame toView:tbc.view];
+        CGRect contentInSuperview = [tbc.view convertRect:contentInTab toView:self.view.superview];
+
+        // 1) Pin native view to the content column (horizontal + vertical).
+        if (!CGRectIsEmpty(contentInSuperview) && !CGRectEqualToRect(self.view.frame, contentInSuperview)) {
+          self.view.frame = contentInSuperview;
+        }
+
+        // 2) Also publish as additional safe area so ScrollView automatic insets / RN
+        // safe-area consumers still pad if frame is fought by Fabric layout.
+        CGRect hostBounds = tbc.view.bounds;
+        CGFloat leading = MAX(0, CGRectGetMinX(contentInTab) - CGRectGetMinX(hostBounds));
+        CGFloat trailing = MAX(0, CGRectGetMaxX(hostBounds) - CGRectGetMaxX(contentInTab));
+        CGFloat top = MAX(0, CGRectGetMinY(contentInTab) - CGRectGetMinY(hostBounds));
+        CGFloat bottom = MAX(0, CGRectGetMaxY(hostBounds) - CGRectGetMaxY(contentInTab));
+        nextInsets = UIEdgeInsetsMake(top, leading, bottom, trailing);
+      }
+    }
+
+    UIEdgeInsets current = self.additionalSafeAreaInsets;
+    if (fabs(current.left - nextInsets.left) > 0.5 || fabs(current.right - nextInsets.right) > 0.5 ||
+        fabs(current.top - nextInsets.top) > 0.5 || fabs(current.bottom - nextInsets.bottom) > 0.5) {
+      self.additionalSafeAreaInsets = nextInsets;
+      [self.view setNeedsLayout];
+    }
+  }
+#endif // !TARGET_OS_TV
+}
