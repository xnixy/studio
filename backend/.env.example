APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/studio
REDIS_URL=redis://localhost:6379/0
# Production: always run migrations via a one-shot job; leave false on multi-replica API.
RUN_DB_MIGRATIONS_ON_STARTUP=false
JWT_SIGNING_KEY=development-signing-key-change-me-32chars
JWT_ISSUER=studio-api
JWT_AUDIENCE=studio-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
REFRESH_COOKIE_NAME=studio_refresh
# lax when SPA shares origin with API (proxy). none when SPA is example.com and API is api.example.com.
REFRESH_COOKIE_SAMESITE=lax
# Optional dedicated HMAC for media URLs (defaults to JWT_SIGNING_KEY).
MEDIA_SIGNING_KEY=
# Comma-separated browser origins allowed for credentialed CORS.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080,https://example.com,https://www.example.com
# Behind Cloudflare / nginx: trust CF-Connecting-IP / X-Forwarded-For for rate limits.
TRUST_PROXY_HEADERS=false
SEED_ADMIN_EMAIL=admin@studio.local
SEED_ADMIN_PASSWORD=Admin123!
APP_BASE_URL=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:3001

# Stripe (web billing). Webhook secret required in production when secret key is set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_CREATOR_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
STRIPE_PACK_VIDEO_10_PRICE_ID=
STRIPE_PACK_VIDEO_25_PRICE_ID=
STRIPE_PACK_IMAGE_50_PRICE_ID=
STRIPE_PACK_VOICE_30M_PRICE_ID=
# Retired SKUs. Keep so unfinished Stripe checkouts still grant.
STRIPE_PACK_LIPSYNC_10_PRICE_ID=
STRIPE_PACK_SCRIPTS_25_PRICE_ID=
STRIPE_PACK_CREATOR_BURST_PRICE_ID=

# Email: prefer SendGrid Web API (recommended). Falls back to SMTP when API key is unset.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Studio
CONTACT_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Cloudflare Turnstile (register + contact). Required in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 (private user media). Recommended for production.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
R2_ENDPOINT_URL=
R2_REGION=auto
MEDIA_DIR=media

# Apple IAP (App Store Server API). Required for real iOS purchases.
APPLE_IAP_BUNDLE_ID=com.example.studio.app
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY=
# Local only (never production):
APPLE_IAP_ALLOW_UNVERIFIED=false

XAI_API_KEY=
XAI_CHAT_URL=https://api.x.ai/v1/chat/completions
XAI_TEXT_MODEL=grok-4.6
XAI_TTS_URL=https://api.x.ai/v1/tts
XAI_TTS_LANGUAGE=en
XAI_TTS_FEMALE_VOICE_ID=ara
XAI_TTS_MALE_VOICE_ID=rex
# Image + video defaults. Video 1.5 is the face-lock / 15s model. Stills default to Image 2.0.
XAI_IMAGE_MODEL=grok-imagine-image-2.0
XAI_VIDEO_MODEL=grok-imagine-video-1.5
XAI_IMAGE_EDIT_URL=https://api.x.ai/v1/images/edits
# Instant Voice Clone + clone TTS. xi-api-key from https://elevenlabs.io/app/settings/api-keys
# Needs a plan that allows IVC (Starter+). TTS is PAYG characters; clone slots are the ElevenLabs plan.
ELEVENLABS_API_KEY=
SEEDANCE_API_KEY=
SEEDANCE_API_BASE_URL=https://api.seevio.ai
SEEDANCE_VIDEO_MODEL=seedance-2-5
KLING_API_KEY=
KLING_API_BASE_URL=https://api-singapore.klingai.com
KLING_VIDEO_MODEL=kling-v3
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
GEMINI_INTERACTIONS_URL=https://generativelanguage.googleapis.com/v1beta/interactions
SYNC_LABS_API_KEY=
SYNC_LABS_BASE_URL=https://api.sync.so
SYNC_LABS_MODEL=sync-3
ASR_ENABLED=true
ASR_WHISPER_MODEL=tiny
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=en
